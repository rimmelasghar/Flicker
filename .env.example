# Copy to .env and fill in. Never commit .env.

# Required: the laptop's LAN IP address (used in the QR code and certificate).
HOST_IP=192.168.1.50

# Required: folder on the laptop where received photos are saved.
# macOS:   /Users/you/Desktop
# Windows: C:/Users/you/Desktop
# Linux:   /home/you/Desktop
INBOX_DIR=/Users/you/Desktop

# Optional: per-file size limit in MB.
MAX_FILE_MB=50

# Optional: per-video size limit in MB (MP4/MOV). 1 min of iPhone 4K is ~350 MB.
MAX_VIDEO_MB=2048

# Optional (Linux): owner of saved files. Run `id -u` and `id -g`.
PUID=1000
PGID=1000

# Optional: allowed deviation in degrees from the calibrated laptop direction.
ANGLE_TOLERANCE=35
